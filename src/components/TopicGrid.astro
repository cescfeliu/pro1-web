---
import TopicCard from './TopicCard.astro';
import topics from '../data/topics.json';
import { unlockDates } from '../data/unlock';

const scopes = ['Parcial', 'Final'] as const;
const blocLabels: Record<string, string> = {
  Parcial: 'temari.blocA',
  Final: 'temari.blocB',
};

const groups = scopes
  .map(scope => {
    const items = topics.filter(topic => topic.scope === scope);
    const ids = items.map(topic => topic.id);
    return {
      scope,
      labelKey: blocLabels[scope],
      items,
      from: Math.min(...ids),
      to: Math.max(...ids),
      unlock: unlockDates[scope] ?? undefined,
    };
  })
  .filter(group => group.items.length > 0);
---

<section id="temari" class="shell py-8 sm:py-10">
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-300 pb-3 dark:border-gray-800"
  >
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filtre per bloc">
      <button type="button" class="filter-btn" data-filter="all" aria-pressed="true" data-i18n="temariPage.tots">
        Tots
      </button>
      <button type="button" class="filter-btn" data-filter="Parcial" aria-pressed="false" data-i18n="temariPage.parcial">
        Parcial
      </button>
      <button type="button" class="filter-btn" data-filter="Final" aria-pressed="false" data-i18n="temariPage.final">
        Final
      </button>
    </div>

    <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-gray-400 dark:text-gray-500">
      {topics.length}
      <span data-i18n="temari.temes">temes</span>
    </p>
  </div>

  {
    groups.map(group => (
      <div class="topic-group mt-9" data-scope={group.scope}>
        <div class="flex items-baseline justify-between gap-4 border-b border-gray-300 pb-1.5 dark:border-gray-800">
          <h2 class="eyebrow">
            <span data-i18n={group.labelKey}>
              {group.scope === 'Parcial' ? 'Bloc A' : 'Bloc B'}
            </span>
            <span class="mx-1.5 text-gray-300 dark:text-gray-700" aria-hidden="true">
              ·
            </span>
            <span class="text-gray-600 dark:text-gray-300">{group.scope}</span>
          </h2>
          <span class="font-mono text-[11px] tabular-nums text-gray-400 dark:text-gray-500">
            <span data-i18n="temari.temes">temes</span> {group.from}–{group.to}
          </span>
        </div>

        <ol class="mt-1">
          {group.items.map(topic => (
            <TopicCard topic={topic} unlock={group.unlock} />
          ))}
        </ol>
      </div>
    ))
  }

  <div class="mt-10 border-t border-gray-300 pt-5 dark:border-gray-800">
    <p class="text-[13px] text-gray-500 dark:text-gray-400" data-i18n="temariPage.credits">
      Contingut basat en els apunts oficials de PRO1 (FIB-UPC)
    </p>
    <p class="mt-1 text-[13px] text-gray-500 dark:text-gray-400">
      <span data-i18n="temariPage.llicons">Lliçons de C++:</span>
      <a href="https://lliçons.jutge.org/cpp/" target="_blank" rel="noopener noreferrer" class="link">
        llicions.jutge.org/cpp/</a
      >
    </p>
  </div>
</section>

<script is:inline>
  // Filtre per bloc (Parcial / Final)
  (() => {
    const buttons = document.querySelectorAll('.filter-btn');
    const rows = document.querySelectorAll('#temari li[data-scope]');
    const groups = document.querySelectorAll('#temari .topic-group');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        buttons.forEach(b => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));

        rows.forEach(row => {
          const scope = row.getAttribute('data-scope');
          const visible = filter === 'all' || filter === 'Final' || scope === filter;
          row.style.display = visible ? '' : 'none';
        });

        groups.forEach(group => {
          const anyVisible = Array.from(group.querySelectorAll('li[data-scope]')).some(
            row => row.style.display !== 'none'
          );
          group.style.display = anyVisible ? '' : 'none';
        });
      });
    });
  })();

  // Temes encara no publicats (data no arribada o professorat)
  (() => {
    const now = Date.now();
    let professor = false;
    try {
      const session = JSON.parse(localStorage.getItem('pro1_session') || 'null');
      professor = Boolean(session && session.role === 'professor');
    } catch (e) {
      professor = false;
    }

    document.querySelectorAll('#temari li[data-unlock-date]').forEach(row => {
      const raw = row.getAttribute('data-unlock-date');
      const unlock = raw ? new Date(raw + 'T00:00:00').getTime() : 0;
      if (professor || now >= unlock) return;
      const link = row.querySelector('a');
      const mark = row.querySelector('.lock-mark');
      if (link) {
        link.removeAttribute('href');
        link.classList.add('pointer-events-none', 'opacity-60');
        link.setAttribute('aria-disabled', 'true');
        link.setAttribute('tabindex', '-1');
      }
      if (mark) mark.classList.remove('hidden');
    });
  })();
</script>
