---
interface Props {
  topic: any;
  unlock?: string | undefined;
}

const { topic, unlock } = Astro.props;
const num = String(topic.id).padStart(2, '0');
---

<li
  data-scope={topic.scope}
  data-searchable={`${topic.title} ${topic.summary} ${topic.keywords.join(' ')}`}
  data-unlock-date={unlock || undefined}
  class="border-b border-gray-200 dark:border-gray-800"
>
  <a
    href={`/tema/${topic.id}`}
    class="group flex items-start gap-4 py-3.5 transition-colors duration-150"
  >
    <span class="w-6 shrink-0 pt-0.5 font-mono text-[13px] tabular-nums text-gray-400 dark:text-gray-500">
      {num}
    </span>

    <span class="min-w-0 flex-1">
      <span
        class="block text-[15px] font-medium leading-snug text-gray-900 transition-colors duration-150 group-hover:text-primary-700 dark:text-gray-100 dark:group-hover:text-primary-300"
      >
        {topic.title}
      </span>
      <span class="mt-1 block text-[13px] leading-snug text-gray-500 dark:text-gray-400">
        {topic.summary}
      </span>
      <span
        class="lock-mark mt-1 hidden font-mono text-[10px] uppercase tracking-[0.1em] text-gray-400"
        data-i18n="temari.bloquejat">Bloquejat</span
      >
    </span>

    <span class="flex shrink-0 items-center gap-3 pt-0.5">
      <span class:list={['badge', topic.scope === 'Parcial' ? 'badge-parcial' : 'badge-final']}>
        {topic.scope}
      </span>
      <span
        class="font-mono text-[13px] text-gray-300 transition-colors duration-150 group-hover:text-primary-600 dark:text-gray-600 dark:group-hover:text-primary-400"
        aria-hidden="true">→</span
      >
    </span>
  </a>
</li>
