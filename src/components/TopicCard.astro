---
interface Props {
  topic: any;
}

const { topic } = Astro.props;

const badgeClass = topic.scope === 'Parcial' ? 'badge-parcial' : 'badge-final';
const isLocked = topic.scope === 'Final';
const unlockDate = '2026-10-30';
---

<article
  class={`card group ${isLocked ? 'topic-locked opacity-50 grayscale pointer-events-none select-none' : ''}`}
  data-searchable={`${topic.title} ${topic.summary} ${topic.keywords.join(' ')}`}
  data-scope={topic.scope}
  data-unlock-date={isLocked ? unlockDate : undefined}
>
  <!-- Card Header -->
  <div class="p-6 pb-4">
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl font-bold text-primary-600 dark:text-primary-400">{topic.id}</span>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">{topic.title}</h3>
      </div>
      <span class={`badge ${badgeClass} shrink-0`}>{topic.scope}</span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{topic.summary}</p>
  </div>

  <!-- Teoria / Bloquejat -->
  {topic.theory && topic.theory.sections && (
    <div class="px-6 pb-4">
      {isLocked ? (
        <div class="locked-content flex items-center gap-2 text-sm font-semibold text-gray-400 dark:text-gray-500">
          <span class="text-base">🔒</span> Bloquejat
        </div>
      ) : (
        <a
          href={`/tema/${topic.id}`}
          class="flex items-center gap-2 text-sm font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
        >
          <span class="text-base">📖</span> Veure teoria del tema
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
  )}

</article>

<script is:inline>
  (function() {
    const now = new Date();
    document.querySelectorAll('.topic-locked').forEach(card => {
      const unlockDate = card.dataset.unlockDate;
      if (!unlockDate) return;

      const unlock = new Date(unlockDate + 'T00:00:00');
      if (now >= unlock) {
        const topicId = card.querySelector('span.text-2xl')?.textContent;
        card.classList.remove('opacity-50', 'grayscale', 'pointer-events-none', 'select-none');
        const lockedContent = card.querySelector('.locked-content');
        if (lockedContent && topicId) {
          lockedContent.outerHTML = `
            <a href="/tema/${topicId}"
               class="flex items-center gap-2 text-sm font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
              <span class="text-base">📖</span> Veure teoria del tema
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          `;
        }
      }
    });
  })();
</script>
