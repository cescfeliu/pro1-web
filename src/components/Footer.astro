---
import fs from 'node:fs';
import path from 'node:path';

const logoPath = path.join(process.cwd(), 'public', 'logo-upc-fib.svg');
const logoSvg = fs.readFileSync(logoPath, 'utf-8')
  .replace(/<\?xml[^?]*\?>\s*/, '')
  .replace(/<!--[\s\S]*?-->\s*/, '')
  .replace('<svg', '<svg class="footer-logo" style="height:2.25rem;width:auto"')
  .replace(
    '.st1{fill:#E42313;}',
    '.st1{fill:#E42313;} .footer-logo .st0,.footer-logo text{transition:fill 0.3s} html.dark .footer-logo .st0{fill:#fff!important} html.dark .footer-logo text{fill:#fff!important}'
  );
---

<footer class="mt-16 border-t border-gray-300 dark:border-gray-800">
  <div class="shell flex flex-col gap-6 py-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
      <div class="flex items-start gap-4">
        <Fragment set:html={logoSvg} />
        <p class="max-w-md text-[13px] leading-relaxed text-gray-500 dark:text-gray-400" data-i18n="footer.infoText">
          Aquest portal és un recurs complementari no oficial. El contingut es basa en el temari
          oficial de PRO1.
        </p>
      </div>

      <nav class="flex flex-col gap-1 font-mono text-[12px] uppercase tracking-[0.06em]" aria-label="Externs">
        <a href="https://jutge.org" target="_blank" rel="noopener noreferrer" class="link">
          Jutge.org ↗
        </a>
        <a href="https://pro1.cs.upc.edu" target="_blank" rel="noopener noreferrer" class="link">
          Web oficial PRO1 ↗
        </a>
        <a href="/enllacos" data-i18n="nav.recursos" class="link">Recursos</a>
      </nav>
    </div>

    <div
      class="flex flex-col gap-1 border-t border-gray-200 pt-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gray-400 dark:border-gray-800 dark:text-gray-500 sm:flex-row sm:justify-between"
    >
      <p>PRO1 / G40 — Aula Lliure · {new Date().getFullYear()}</p>
      <p data-i18n="footer.credits">Fet per Cesc Feliu — Recurs no oficial de la UPC</p>
    </div>
  </div>
</footer>
