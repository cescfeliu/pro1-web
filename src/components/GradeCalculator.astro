---
---

<section class="card">
  <div
    class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-gray-200 px-5 py-4 dark:border-gray-800"
  >
    <h3 class="text-[15px] font-semibold" data-i18n="calculator.title">Calculadora de notes</h3>
    <p class="font-mono text-[13px] text-gray-600 dark:text-gray-300">
      N = max(0,4 × P + 0,6 × F, F)
    </p>
  </div>

  <div class="p-5">
    <!-- Parcial -->
    <div>
      <div class="flex items-baseline justify-between gap-4">
        <label for="parcial-slider" class="eyebrow" data-i18n="calculator.parcial">
          Examen Parcial (P)
        </label>
        <span
          id="parcial-value"
          class="font-mono text-[15px] font-medium tabular-nums text-primary-700 dark:text-primary-300"
          >5.0</span
        >
      </div>
      <input
        type="range"
        id="parcial-slider"
        min="0"
        max="10"
        step="0.1"
        value="5.0"
        class="slider mt-3"
      />
    </div>

    <!-- Final -->
    <div class="mt-6">
      <div class="flex items-baseline justify-between gap-4">
        <label for="final-slider" class="eyebrow" data-i18n="calculator.final">
          Examen Final (F)
        </label>
        <span
          id="final-value"
          class="font-mono text-[15px] font-medium tabular-nums text-primary-700 dark:text-primary-300"
          >5.0</span
        >
      </div>
      <input
        type="range"
        id="final-slider"
        min="0"
        max="10"
        step="0.1"
        value="5.0"
        class="slider mt-3"
      />
    </div>

    <!-- Resultats -->
    <div class="mt-6 border-t border-gray-200 pt-4 dark:border-gray-800">
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <p class="eyebrow" data-i18n="calculator.mitjana">Mitjana ponderada</p>
          <p class="mt-1 font-mono text-[11px] tabular-nums text-gray-400">0,4 × P + 0,6 × F</p>
        </div>
        <span id="weighted-result" class="font-mono text-[18px] tabular-nums text-gray-700 dark:text-gray-200"
          >5.00</span
        >
      </div>

      <div id="final-note-box" class="mt-4 border p-4">
        <div class="flex items-baseline justify-between gap-4">
          <div class="min-w-0">
            <p class="eyebrow" data-i18n="calculator.notaGlobal">Nota Global (N)</p>
            <p id="final-note-status" class="mt-1.5 text-[13px] leading-snug"></p>
          </div>
          <span
            id="final-note"
            class="font-mono text-[32px] font-medium leading-none tabular-nums text-gray-900 dark:text-gray-50"
            >5.00</span
          >
        </div>
      </div>
    </div>

    <!-- Quant necessito al final? -->
    <div class="mt-6 border-t border-gray-200 pt-4 dark:border-gray-800">
      <h4 class="eyebrow" data-i18n="calculator.quantFinal">Quant necessito al Final?</h4>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div class="border border-gray-200 p-3 dark:border-gray-800">
          <p class="text-[13px] leading-snug text-gray-500 dark:text-gray-400" data-i18n="calculator.per5">
            Per a un 5.0 (Aprovat)
          </p>
          <p
            id="need-for-5"
            class="mt-1 font-mono text-[20px] font-medium tabular-nums text-primary-700 dark:text-primary-300"
          >
            5.00
          </p>
        </div>
        <div class="border border-gray-200 p-3 dark:border-gray-800">
          <p class="text-[13px] leading-snug text-gray-500 dark:text-gray-400" data-i18n="calculator.per7">
            Per a un 7.0 (Notable)
          </p>
          <p
            id="need-for-7"
            class="mt-1 font-mono text-[20px] font-medium tabular-nums text-primary-700 dark:text-primary-300"
          >
            7.00
          </p>
        </div>
      </div>
      <p
        id="impossible-note"
        class="mt-3 hidden border-l-2 border-red-300 pl-3 text-[13px] text-red-700 dark:border-red-800 dark:text-red-300"
        data-i18n="calculator.impossible"
      >
        No és possible assolir aquesta nota amb els valors actuals de P.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  const parcialSlider = document.getElementById('parcial-slider');
  const finalSlider = document.getElementById('final-slider');
  const parcialValue = document.getElementById('parcial-value');
  const finalValue = document.getElementById('final-value');
  const weightedResult = document.getElementById('weighted-result');
  const finalNote = document.getElementById('final-note');
  const finalNoteBox = document.getElementById('final-note-box');
  const finalNoteStatus = document.getElementById('final-note-status');
  const needFor5 = document.getElementById('need-for-5');
  const needFor7 = document.getElementById('need-for-7');
  const impossibleNote = document.getElementById('impossible-note');

  const calcStatusTranslations = {
    ca: { excelent: 'Excel·lent! Has aprovat amb nota.', be: 'Bé! Has aprovat.', justet: 'Justet! Has aprovat però és millor millorar.', suspes: 'Suspès. Necessites més nota.' },
    es: { excelent: '¡Excelente! Has aprobado con nota.', be: '¡Bien! Has aprobado.', justet: '¡Justito! Has aprobado pero es mejor mejorar.', suspes: 'Suspenso. Necesitas más nota.' },
    en: { excelent: 'Excellent! You passed with a good grade.', be: 'Good! You passed.', justet: 'Just barely! You passed but it\'s better to improve.', suspes: 'Failed. You need a higher grade.' }
  };

  const BOX_BASE = 'mt-4 border p-4 ';
  const NOTE_BASE = 'font-mono text-[32px] font-medium leading-none tabular-nums ';
  const STATUS_BASE = 'mt-1.5 text-[13px] leading-snug ';

  function calculate() {
    const p = parseFloat(parcialSlider.value);
    const f = parseFloat(finalSlider.value);
    const lang = localStorage.getItem('lang') || 'ca';
    const t = calcStatusTranslations[lang] || calcStatusTranslations.ca;

    parcialValue.textContent = p.toFixed(1);
    finalValue.textContent = f.toFixed(1);

    const weighted = 0.4 * p + 0.6 * f;
    weightedResult.textContent = weighted.toFixed(2);

    const final = Math.max(weighted, f);
    finalNote.textContent = final.toFixed(2);

    if (final >= 5.0) {
      if (final >= 7.0) {
        finalNoteBox.className = BOX_BASE + 'border-primary-600 bg-primary-50 dark:border-primary-800 dark:bg-primary-950/40';
        finalNoteStatus.textContent = t.excelent;
        finalNoteStatus.className = STATUS_BASE + 'text-primary-700 dark:text-primary-300';
        finalNote.className = NOTE_BASE + 'text-primary-700 dark:text-primary-300';
      } else if (final >= 6.0) {
        finalNoteBox.className = BOX_BASE + 'border-primary-300 bg-white dark:border-primary-900 dark:bg-gray-900';
        finalNoteStatus.textContent = t.be;
        finalNoteStatus.className = STATUS_BASE + 'text-primary-700 dark:text-primary-300';
        finalNote.className = NOTE_BASE + 'text-primary-700 dark:text-primary-300';
      } else {
        finalNoteBox.className = BOX_BASE + 'border-amber-300 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30';
        finalNoteStatus.textContent = t.justet;
        finalNoteStatus.className = STATUS_BASE + 'text-amber-700 dark:text-amber-300';
        finalNote.className = NOTE_BASE + 'text-amber-700 dark:text-amber-300';
      }
    } else {
      finalNoteBox.className = BOX_BASE + 'border-red-300 bg-red-50 dark:border-red-800 dark:bg-red-950/30';
      finalNoteStatus.textContent = t.suspes;
      finalNoteStatus.className = STATUS_BASE + 'text-red-700 dark:text-red-300';
      finalNote.className = NOTE_BASE + 'text-red-700 dark:text-red-300';
    }

    const neededFor5Case2 = (5.0 - 0.4 * p) / 0.6;
    const neededFor5 = Math.max(5.0, neededFor5Case2);

    const neededFor7Case2 = (7.0 - 0.4 * p) / 0.6;
    const neededFor7 = Math.max(7.0, neededFor7Case2);

    if (neededFor5 <= 10) {
      needFor5.textContent = neededFor5.toFixed(2);
    } else {
      needFor5.textContent = '> 10';
    }

    if (neededFor7 <= 10) {
      needFor7.textContent = neededFor7.toFixed(2);
    } else {
      needFor7.textContent = '> 10';
    }

    if (neededFor5 > 10) {
      impossibleNote.classList.remove('hidden');
    } else {
      impossibleNote.classList.add('hidden');
    }
  }

  parcialSlider?.addEventListener('input', calculate);
  finalSlider?.addEventListener('input', calculate);
  window.addEventListener('lang-changed', calculate);
  calculate();
</script>
