---
import LanguageSelector from './LanguageSelector.astro';

const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const links = [
  { href: '/temari', i18n: 'nav.temari', label: 'Temari' },
  { href: '/sessions', i18n: 'nav.sessions', label: 'Sessions' },
  { href: '/avaluacio', i18n: 'nav.calculadora', label: 'Calculadora' },
  { href: '/enllacos', i18n: 'nav.recursos', label: 'Recursos' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-gray-300 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
>
  <div class="shell flex h-12 items-center gap-3">
    <a
      href="/"
      class="flex items-baseline font-mono text-[13px] font-medium tracking-[-0.01em] text-gray-900 dark:text-gray-50"
    >
      <span>PRO1</span><span class="text-primary-600 dark:text-primary-400">/G40</span>
    </a>
    <span class="hidden whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.16em] text-gray-400 2xl:inline">
      FIB · UPC
    </span>

    <nav class="ml-auto hidden items-center md:flex" aria-label="Principal">
      {
        links.map(link => (
          <a
            href={link.href}
            data-i18n={link.i18n}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap border-b-2 px-2 py-1 font-mono text-[12px] uppercase tracking-[0.06em] transition-colors duration-150',
              isActive(link.href)
                ? 'border-primary-600 text-primary-700 dark:border-primary-400 dark:text-primary-300'
                : 'border-transparent text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/logins"
        data-i18n="nav.logins"
        class="nav-logins hidden whitespace-nowrap border-b-2 border-transparent px-2 py-1 font-mono text-[12px] uppercase tracking-[0.06em] text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >
        Inicis de sessió
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 md:ml-3">
      <div class="relative hidden xl:block">
        <input
          type="search"
          id="search-input"
          placeholder="Cercar (ex: matrius, P90615)..."
          data-i18n-placeholder="nav.search"
          aria-label="Cercar"
          class="field w-44 py-1.5 pl-7 font-mono text-[12px] 2xl:w-64"
        />
        <svg
          class="pointer-events-none absolute left-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-gray-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <button
        id="theme-toggle"
        type="button"
        class="icon-btn"
        aria-label="Canviar tema"
        title="Canviar tema"
      >
        <svg class="hidden h-4 w-4 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg class="block h-4 w-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <LanguageSelector />

      <div
        id="user-chip"
        class="hidden items-center gap-1.5 border-l border-gray-300 pl-2 dark:border-gray-800"
      >
        <span
          id="user-name"
          class="hidden max-w-[7rem] truncate font-mono text-[11px] text-gray-600 dark:text-gray-300 sm:block xl:max-w-[10rem]"
        ></span>
        <button
          id="logout-btn"
          type="button"
          class="icon-btn"
          data-i18n-title="nav.logout"
          title="Tancar sessió"
          aria-label="Tancar sessió"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
            <polyline points="16 17 21 12 16 7" stroke-linecap="round" stroke-linejoin="round"
            ></polyline>
            <line x1="21" y1="12" x2="9" y2="12" stroke-linecap="round"></line>
          </svg>
        </button>
      </div>

      <button
        id="mobile-menu-btn"
        type="button"
        class="icon-btn md:hidden"
        aria-label="Obrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú mòbil -->
  <div id="mobile-menu" class="hidden border-t border-gray-200 dark:border-gray-800 md:hidden">
    <div class="shell flex flex-col py-2">
      {
        links.map(link => (
          <a
            href={link.href}
            data-i18n={link.i18n}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between whitespace-nowrap border-b border-gray-200 py-2.5 font-mono text-[13px] uppercase tracking-[0.06em] dark:border-gray-800',
              isActive(link.href)
                ? 'text-primary-700 dark:text-primary-300'
                : 'text-gray-700 dark:text-gray-300',
            ]}
          >
            {link.label}
            <span class="text-gray-400" aria-hidden="true">
              /
            </span>
          </a>
        ))
      }
      <a
        href="/logins"
        data-i18n="nav.logins"
        class="nav-logins hidden whitespace-nowrap py-2.5 font-mono text-[13px] uppercase tracking-[0.06em] text-gray-700 dark:text-gray-300"
      >
        Inicis de sessió
      </a>

      <div class="relative mt-3">
        <input
          type="search"
          id="search-input-mobile"
          placeholder="Cercar..."
          data-i18n-placeholder="nav.searchMobile"
          aria-label="Cercar"
          class="field w-full py-2 pl-7 font-mono text-[12px]"
        />
        <svg
          class="pointer-events-none absolute left-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-gray-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Session chip + logout
  (() => {
    let session = null;
    try {
      session = JSON.parse(localStorage.getItem('pro1_session') || 'null');
    } catch (e) {
      session = null;
    }
    const chip = document.getElementById('user-chip');
    const nameEl = document.getElementById('user-name');
    if (session && session.name && chip && nameEl) {
      nameEl.textContent = session.name;
      chip.classList.remove('hidden');
      chip.classList.add('flex');
      if (session.role === 'professor') {
        document.querySelectorAll('.nav-logins').forEach(el => el.classList.remove('hidden'));
      }
    }
    document.getElementById('logout-btn')?.addEventListener('click', () => {
      localStorage.removeItem('pro1_session');
      location.href = '/login';
    });
  })();

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });

  // Mobile menu
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuBtn?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    mobileMenuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Cerca global: filtra els elements amb data-searchable de la pàgina
  function bindSearch(id) {
    const input = document.getElementById(id);
    input?.addEventListener('input', e => {
      const query = e.target.value.toLowerCase().trim();
      document.querySelectorAll('[data-searchable]').forEach(el => {
        const text = el.getAttribute('data-searchable')?.toLowerCase() || '';
        el.style.display = query === '' || text.includes(query) ? '' : 'none';
      });
    });
  }
  bindSearch('search-input');
  bindSearch('search-input-mobile');
</script>
