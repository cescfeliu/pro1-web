---
---

<div class="relative" id="lang-selector">
  <button
    id="lang-toggle"
    type="button"
    class="p-2 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors text-sm font-medium"
    aria-label="Canviar idioma"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
  </button>
  <div id="lang-dropdown" class="hidden absolute right-0 top-full mt-2 w-36 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl shadow-lg overflow-hidden z-50">
    <button data-lang="ca" class="lang-option w-full px-4 py-2.5 text-left text-sm hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center gap-2">
      <span data-i18n="lang.ca">Català</span>
    </button>
    <button data-lang="es" class="lang-option w-full px-4 py-2.5 text-left text-sm hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center gap-2">
      <span data-i18n="lang.es">Castellà</span>
    </button>
    <button data-lang="en" class="lang-option w-full px-4 py-2.5 text-left text-sm hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center gap-2">
      <span data-i18n="lang.en">Anglès</span>
    </button>
  </div>
</div>

<script is:inline>
  const langToggle = document.getElementById('lang-toggle');
  const langDropdown = document.getElementById('lang-dropdown');
  const langOptions = document.querySelectorAll('.lang-option');

  langToggle?.addEventListener('click', () => {
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('#lang-selector')) {
      langDropdown?.classList.add('hidden');
    }
  });

  langOptions.forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      if (lang) {
        localStorage.setItem('lang', lang);
        document.documentElement.lang = lang;
        if (typeof applyTranslations === 'function') {
          applyTranslations(lang);
        }
        langDropdown?.classList.add('hidden');
      }
    });
  });
</script>
