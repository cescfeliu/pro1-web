---
---

<div class="relative" id="lang-selector">
  <button
    id="lang-toggle"
    type="button"
    class="icon-btn font-mono text-[11px] font-medium uppercase tracking-[0.08em]"
    aria-label="Canviar idioma"
    title="Canviar idioma"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <span aria-hidden="true">CA</span>
  </button>
  <div
    id="lang-dropdown"
    class="hidden absolute right-0 top-full z-50 mt-1 w-36 overflow-hidden rounded-[3px] border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900"
  >
    <button
      data-lang="ca"
      class="lang-option flex w-full items-center justify-between px-3 py-2 text-left font-mono text-[12px] uppercase tracking-[0.06em] text-gray-700 transition-colors hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      <span data-i18n="lang.ca">Català</span>
      <span class="lang-mark text-primary-600 dark:text-primary-400" aria-hidden="true"></span>
    </button>
    <button
      data-lang="es"
      class="lang-option flex w-full items-center justify-between border-t border-gray-100 px-3 py-2 text-left font-mono text-[12px] uppercase tracking-[0.06em] text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      <span data-i18n="lang.es">Castellà</span>
      <span class="lang-mark text-primary-600 dark:text-primary-400" aria-hidden="true"></span>
    </button>
    <button
      data-lang="en"
      class="lang-option flex w-full items-center justify-between border-t border-gray-100 px-3 py-2 text-left font-mono text-[12px] uppercase tracking-[0.06em] text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      <span data-i18n="lang.en">Anglès</span>
      <span class="lang-mark text-primary-600 dark:text-primary-400" aria-hidden="true"></span>
    </button>
  </div>
</div>

<script is:inline>
  const langToggle = document.getElementById('lang-toggle');
  const langDropdown = document.getElementById('lang-dropdown');
  const langOptions = document.querySelectorAll('.lang-option');
  const langCurrent = document.querySelector('#lang-toggle span');

  function syncLangLabel() {
    const lang = localStorage.getItem('lang') || 'ca';
    if (langCurrent) langCurrent.textContent = lang.toUpperCase();
    langOptions.forEach(btn => {
      const mark = btn.querySelector('.lang-mark');
      if (!mark) return;
      mark.textContent = btn.getAttribute('data-lang') === lang ? '✓' : '';
    });
    langToggle?.setAttribute('aria-expanded', langDropdown?.classList.contains('hidden') ? 'false' : 'true');
  }

  langToggle?.addEventListener('click', () => {
    langDropdown?.classList.toggle('hidden');
    syncLangLabel();
  });

  document.addEventListener('click', e => {
    if (!e.target.closest('#lang-selector')) {
      langDropdown?.classList.add('hidden');
      langToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      langDropdown?.classList.add('hidden');
      langToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  langOptions.forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      if (lang) {
        localStorage.setItem('lang', lang);
        document.documentElement.lang = lang;
        if (typeof applyTranslations === 'function') {
          applyTranslations(lang);
        }
        langDropdown?.classList.add('hidden');
        syncLangLabel();
      }
    });
  });

  syncLangLabel();
  window.addEventListener('lang-changed', syncLangLabel);
</script>
