---
import exercises from '../data/exercises.json';

interface Props {
  topicFilter?: number;
}

const { topicFilter } = Astro.props;

const filteredExercises = topicFilter
  ? exercises.filter(ex => ex.topic === topicFilter)
  : exercises;

const difficultyColor = (d: string) => {
  if (d === 'Fàcil') return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
  if (d === 'Mitjà') return 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200';
  return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
};
---

<div class="space-y-6">
  {filteredExercises.map(exercise => (
    <div class="card" id={`exercise-${exercise.id}`}>
      <!-- Exercise Header -->
      <div class="p-6 border-b border-gray-100 dark:border-gray-800">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">{exercise.title}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">Tema {exercise.topic}</p>
          </div>
          <span class={`badge ${difficultyColor(exercise.difficulty)}`}>
            {exercise.difficulty}
          </span>
        </div>
      </div>

      <!-- Description -->
      <div class="p-6 pb-4">
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{exercise.description}</p>
      </div>

      <!-- Input/Output -->
      <div class="px-6 pb-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4">
          <h4 class="text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide mb-2">Entrada</h4>
          <p class="text-sm text-gray-600 dark:text-gray-400 font-mono">{exercise.input}</p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4">
          <h4 class="text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide mb-2">Sortida</h4>
          <p class="text-sm text-gray-600 dark:text-gray-400 font-mono">{exercise.output}</p>
        </div>
      </div>

      <!-- Example -->
      <div class="px-6 pb-4">
        <div class="bg-gray-900 dark:bg-gray-800 rounded-xl p-4">
          <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Exemple</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <span class="text-gray-500">Entrada:</span>
              <pre class="text-green-400 font-mono mt-1">{exercise.example.input}</pre>
            </div>
            <div>
              <span class="text-gray-500">Sortida:</span>
              <pre class="text-blue-400 font-mono mt-1">{exercise.example.output}</pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Hints -->
      <div class="px-6 pb-4">
        <details class="group/hints">
          <summary class="cursor-pointer text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors flex items-center gap-2">
            💡 Pistes (intenta-ho primer!)
            <svg class="w-4 h-4 transition-transform group-open/hints:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <ul class="mt-3 space-y-2">
            {exercise.hints.map((hint, i) => (
              <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                <span class="text-primary-500 mt-0.5 shrink-0">{i + 1}.</span>
                <span>{hint}</span>
              </li>
            ))}
          </ul>
        </details>
      </div>

      <!-- Solution -->
      <div class="px-6 pb-6">
        <details class="group/solution">
          <summary class="cursor-pointer text-sm font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors flex items-center gap-2">
            💻 Solució
            <svg class="w-4 h-4 transition-transform group-open/solution:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 space-y-4">
            <!-- Solution Explanation -->
            <div class="bg-blue-50 dark:bg-blue-950/30 rounded-xl p-4 border border-blue-200 dark:border-blue-800">
              <h4 class="text-sm font-semibold text-blue-700 dark:text-blue-300 mb-2">Explicació pas a pas:</h4>
              <ol class="space-y-1">
                {exercise.solutionExplanations.map(exp => (
                  <li class="text-sm text-blue-600 dark:text-blue-400 flex items-start gap-2">
                    <span class="shrink-0">→</span>
                    <span>{exp}</span>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Code Block -->
            <div class="relative">
              <pre class="code-block text-sm"><code>{exercise.solution}</code></pre>
              <button
                class="copy-solution-btn absolute top-3 right-3 px-3 py-1 text-xs bg-gray-700 hover:bg-gray-600 text-gray-300 rounded-lg transition-colors"
                data-solution={exercise.solution}
              >
                Copiar Codi
              </button>
            </div>
          </div>
        </details>
      </div>
    </div>
  ))}
</div>

<script is:inline>
  document.querySelectorAll('.copy-solution-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const solution = btn.getAttribute('data-solution');
      if (solution) {
        navigator.clipboard.writeText(solution).then(() => {
          const originalText = btn.textContent;
          btn.textContent = 'Copiat!';
          setTimeout(() => { btn.textContent = originalText; }, 2000);
        });
      }
    });
  });
</script>
