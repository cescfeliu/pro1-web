---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portal d'apunts, consells d'examen i recursos per a PRO1 G40 - Aula Lliure UPC" } = Astro.props;
---

<!doctype html>
<html lang="ca" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Cesc Feliu" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 transition-colors duration-300">
    <slot />
    <script is:inline src="/i18n/translations.js"></script>
    <script is:inline>
      // Theme
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);

      // i18n
      const savedLang = localStorage.getItem('lang') || 'ca';
      document.documentElement.lang = savedLang;
      if (window.applyTranslations) {
        applyTranslations(savedLang);
      } else {
        document.addEventListener('DOMContentLoaded', () => applyTranslations(savedLang));
      }
    </script>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    * {
      @apply border-gray-200 dark:border-gray-800;
    }
  }

  @layer components {
    .card {
      @apply bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 overflow-hidden;
    }

    .badge {
      @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium;
    }

    .badge-parcial {
      @apply bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200;
    }

    .badge-final {
      @apply bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200;
    }

    .btn {
      @apply inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl font-medium text-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-gray-900;
    }

    .btn-primary {
      @apply bg-primary-600 text-white hover:bg-primary-700 focus:ring-primary-500 shadow-md hover:shadow-lg;
    }

    .btn-secondary {
      @apply bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 focus:ring-gray-500;
    }

    .code-block {
      @apply bg-gray-900 text-gray-100 rounded-xl p-4 overflow-x-auto font-mono text-sm leading-relaxed;
    }

    .slider {
      @apply w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-primary-600;
    }

    .slider::-webkit-slider-thumb {
      @apply appearance-none w-5 h-5 bg-primary-600 rounded-full cursor-pointer shadow-md;
    }
  }
</style>
