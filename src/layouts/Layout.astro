---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Portal d'apunts, consells d'examen i recursos per a PRO1 G40 - Aula Lliure UPC", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="ca" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Cesc Feliu" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Auth gate: only the login page is public
      (() => {
        const path = location.pathname.replace(/\/+$/, '') || '/';
        if (path === '/login' || path === '/login.html') return;
        let session = null;
        try {
          session = JSON.parse(localStorage.getItem('pro1_session') || 'null');
        } catch (e) {
          session = null;
        }
        if (!session || !session.name) {
          location.replace('/login');
          return;
        }
        // Access control: revoked students are logged out (restricted by default)
        if (session.role !== 'professor') {
          try {
            if (localStorage.getItem('pro1_access') !== 'open') {
              const allowed = JSON.parse(localStorage.getItem('pro1_allowed') || '[]');
              const key = String(session.name).trim().replace(/\s+/g, ' ').toLowerCase();
              const stillAllowed = Array.isArray(allowed) && allowed.some(item => item && String(item.name || '').trim().replace(/\s+/g, ' ').toLowerCase() === key);
              if (!stillAllowed) {
                const denied = JSON.parse(localStorage.getItem('pro1_denied') || '[]');
                const list = Array.isArray(denied) ? denied : [];
                const now = Date.now();
                const found = list.find(item => item && item.key === key);
                if (found) {
                  found.count = (found.count || 1) + 1;
                  found.last = now;
                  found.name = session.name;
                } else {
                  list.push({ key: key, name: session.name, count: 1, first: now, last: now });
                }
                localStorage.setItem('pro1_denied', JSON.stringify(list.slice(-300)));
                localStorage.removeItem('pro1_session');
                location.replace('/login?denied=1');
                return;
              }
            }
          } catch (e) {
            /* ignore */
          }
        }
        // Professor-only area
        if (path === '/logins' && session.role !== 'professor') {
          location.replace('/');
        }
      })();
    </script>
  </head>
  <body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 transition-colors duration-300">
    <slot />
    <script is:inline src="/i18n/translations.js"></script>
    <script is:inline>
      // Theme
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);

      // i18n
      const savedLang = localStorage.getItem('lang') || 'ca';
      document.documentElement.lang = savedLang;
      if (window.applyTranslations) {
        applyTranslations(savedLang);
      } else {
        document.addEventListener('DOMContentLoaded', () => applyTranslations(savedLang));
      }
    </script>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  /* Fonts autoallotjades al /public (sense tercers) */
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/inter-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/inter-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'Fira Code';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/fira-code-400-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Fira Code';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/fira-code-400-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'Fira Code';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/fira-code-500-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Fira Code';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/fira-code-500-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @layer base {
    * {
      @apply border-gray-200 dark:border-gray-800;
    }
  }

  @layer components {
    .card {
      @apply bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 overflow-hidden;
    }

    .badge {
      @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium;
    }

    .badge-parcial {
      @apply bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200;
    }

    .badge-final {
      @apply bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200;
    }

    .btn {
      @apply inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl font-medium text-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-gray-900;
    }

    .btn-primary {
      @apply bg-primary-600 text-white hover:bg-primary-700 focus:ring-primary-500 shadow-md hover:shadow-lg;
    }

    .btn-secondary {
      @apply bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 focus:ring-gray-500;
    }

    .code-block {
      @apply bg-gray-900 text-gray-100 rounded-xl p-4 overflow-x-auto font-mono text-sm leading-relaxed;
    }

    .slider {
      @apply w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-primary-600;
    }

    .slider::-webkit-slider-thumb {
      @apply appearance-none w-5 h-5 bg-primary-600 rounded-full cursor-pointer shadow-md;
    }
  }
</style>
