---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacte - PRO1 G40">
  <Navbar />

  <main class="pt-24 pb-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4" data-i18n="contacte.title">
          Contacte
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400" data-i18n="contacte.subtitle">
          Tens un dubte o t'has quedat encallat? Envia'm un missatge i et contesto el més aviat possible.
        </p>
      </div>

      <div class="card p-8">
        <form
          action="https://formspree.io/f/YOUR_FORM_ID"
          method="POST"
          class="space-y-6"
        >
          <div>
            <label for="nom" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="contacte.nom">
              Nom
            </label>
            <input
              type="text"
              id="nom"
              name="nom"
              required
              placeholder="El teu nom"
              data-i18n-placeholder="contacte.nomPlaceholder"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
            />
          </div>

          <div>
            <label for="correu" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="contacte.correu">
              Correu electrònic
            </label>
            <input
              type="email"
              id="correu"
              name="correu"
              required
              placeholder="el-teu-correu@exemple.com"
              data-i18n-placeholder="contacte.correuPlaceholder"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
            />
          </div>

          <div>
            <label for="missatge" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="contacte.missatge">
              Missatge
            </label>
            <textarea
              id="missatge"
              name="missatge"
              rows="5"
              required
              placeholder="Explica'ns el teu dubte..."
              data-i18n-placeholder="contacte.missatgePlaceholder"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full btn btn-primary py-3 text-base"
            data-i18n="contacte.enviar"
          >
            Enviar missatge
          </button>
        </form>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
