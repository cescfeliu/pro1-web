---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import topics from '../data/topics.json';
import { unlockDates } from '../data/unlock';

const topicRows = topics.map(topic => ({
  id: topic.id,
  title: topic.title,
  scope: topic.scope,
  summary: topic.summary,
  keywords: topic.keywords,
  unlock: unlockDates[topic.scope] ?? undefined,
}));
---

<Layout title="PRO1 G40 — Aula Lliure">
  <Navbar />

  <main id="main">
    <!-- Identificació -->
    <section class="border-b border-gray-300 dark:border-gray-800">
      <div class="shell py-9 sm:py-12">
        <p class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-1">
          <span>PRO1 / G40</span>
          <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span>FIB · UPC</span>
          <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span data-i18n="home.kicker">Material d'estudi</span>
        </p>

        <h1 class="page-title mt-4">Programació 1</h1>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400" data-i18n="home.lead">
          Apunts del temari i eines per preparar PRO1 a l'aula lliure del grup G40.
        </p>

        <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[12px] text-gray-500 dark:text-gray-400">
          <span data-i18n="hero.badge">Divendres de 12:00 - 14:00</span>
          <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span>Aula B5S202</span>
        </p>
      </div>
    </section>

    <!-- A. Temari -->
    <section class="border-b border-gray-300 dark:border-gray-800">
      <div class="shell py-8 sm:py-10">
        <div class="section-head">
          <div class="flex items-baseline gap-3">
            <span class="eyebrow">01</span>
            <h2 class="text-[15px] font-semibold" data-i18n="home.s1">Temari</h2>
          </div>
          <a href="/temari" data-i18n="home.veureTemari" class="link font-mono text-[12px] uppercase tracking-[0.06em]">
            Veure tot el temari →
          </a>
        </div>

        <ol class="mt-1 grid gap-x-10 sm:grid-cols-2">
          {
            topicRows.map(topic => (
              <li
                class="border-b border-gray-200 last:border-b-0 dark:border-gray-800"
                data-searchable={`${topic.title} ${topic.summary} ${topic.keywords.join(' ')}`}
                data-unlock-date={topic.unlock || undefined}
              >
                <a
                  href={`/tema/${topic.id}`}
                  class="group flex items-baseline gap-3 py-2.5 transition-colors hover:text-primary-700 dark:hover:text-primary-300"
                >
                  <span class="w-6 shrink-0 font-mono text-[12px] tabular-nums text-gray-400 dark:text-gray-500">
                    {String(topic.id).padStart(2, '0')}
                  </span>
                  <span class="min-w-0 flex-1 truncate text-[14px] text-gray-800 group-hover:text-primary-700 dark:text-gray-200 dark:group-hover:text-primary-300">
                    {topic.title}
                  </span>
                  <span class="lock-mark hidden font-mono text-[10px] uppercase tracking-[0.1em] text-gray-400" data-i18n="temari.bloquejat">
                    Bloquejat
                  </span>
                  <span class:list={['badge', topic.scope === 'Parcial' ? 'badge-parcial' : 'badge-final']}>
                    {topic.scope}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- B. Exàmens -->
    <section class="border-b border-gray-300 dark:border-gray-800">
      <div class="shell py-8 sm:py-10">
        <div class="section-head">
          <div class="flex items-baseline gap-3">
            <span class="eyebrow">02</span>
            <h2 class="text-[15px] font-semibold" data-i18n="home.s2">Exàmens</h2>
          </div>
          <a href="/avaluacio" data-i18n="home.calcCta" class="link font-mono text-[12px] uppercase tracking-[0.06em]">
            Calculadora de notes →
          </a>
        </div>

        <div class="mt-2 overflow-x-auto">
          <table class="w-full min-w-[34rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-800">
                <th scope="col" class="eyebrow py-2 pr-4 font-normal" data-i18n="home.examProva">Prova</th>
                <th scope="col" class="eyebrow py-2 pr-4 font-normal" data-i18n="home.examData">Data</th>
                <th scope="col" class="eyebrow py-2 pr-4 font-normal" data-i18n="home.examHorari">Horari</th>
                <th scope="col" class="eyebrow py-2 text-right font-normal" data-i18n="home.examDies">En</th>
              </tr>
            </thead>
            <tbody>
              <tr id="parcial-row" class="border-b border-gray-200 dark:border-gray-800">
                <td class="py-3 pr-4 text-[14px] font-medium" data-i18n="countdown.parcial">Examen Parcial</td>
                <td class="py-3 pr-4 font-mono text-[13px] text-gray-600 dark:text-gray-300">29/10/2026</td>
                <td class="py-3 pr-4 font-mono text-[13px] text-gray-600 dark:text-gray-300">15:30 · 18:00</td>
                <td class="py-3 text-right">
                  <span id="countdown-parcial" class="font-mono text-[18px] font-medium tabular-nums">—</span>
                  <span class="block font-mono text-[10px] uppercase tracking-[0.1em] text-gray-400" data-i18n="countdown.dies">
                    dies restants
                  </span>
                </td>
              </tr>
              <tr id="final-row" class="border-b border-gray-200 dark:border-gray-800">
                <td class="py-3 pr-4 text-[14px] font-medium" data-i18n="countdown.final">Examen Final</td>
                <td class="py-3 pr-4 font-mono text-[13px] text-gray-600 dark:text-gray-300">08/01/2027</td>
                <td class="py-3 pr-4 font-mono text-[13px] text-gray-600 dark:text-gray-300">08:00 · 11:30</td>
                <td class="py-3 text-right">
                  <span id="countdown-final" class="font-mono text-[18px] font-medium tabular-nums">—</span>
                  <span class="block font-mono text-[10px] uppercase tracking-[0.1em] text-gray-400" data-i18n="countdown.dies">
                    dies restants
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- C / D / E -->
    <section class="border-b border-gray-300 dark:border-gray-800">
      <div class="shell grid divide-y divide-gray-200 py-0 dark:divide-gray-800 lg:grid-cols-3 lg:divide-x lg:divide-y-0">
        <!-- C. Recursos -->
        <div class="py-8 lg:pr-8">
          <div class="flex items-baseline gap-3">
            <span class="eyebrow">03</span>
            <h2 class="text-[15px] font-semibold" data-i18n="home.s3">Recursos</h2>
          </div>
          <ul class="mt-3">
            <li class="border-b border-gray-200 dark:border-gray-800">
              <a href="https://jutge.org" target="_blank" rel="noopener noreferrer" class="group flex items-baseline justify-between gap-3 py-2.5">
                <span class="text-[14px] text-gray-800 group-hover:text-primary-700 dark:text-gray-200 dark:group-hover:text-primary-300">Jutge.org</span>
                <span class="font-mono text-[12px] text-gray-400" aria-hidden="true">↗</span>
              </a>
            </li>
            <li class="border-b border-gray-200 dark:border-gray-800">
              <a href="https://lliçons.jutge.org/cpp/" target="_blank" rel="noopener noreferrer" class="group flex items-baseline justify-between gap-3 py-2.5">
                <span class="text-[14px] text-gray-800 group-hover:text-primary-700 dark:text-gray-200 dark:group-hover:text-primary-300" data-i18n="enllacos.llicons">
                  Lliçons de C++
                </span>
                <span class="font-mono text-[12px] text-gray-400" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a href="/enllacos" class="group flex items-baseline justify-between gap-3 py-2.5">
                <span class="text-[14px] text-gray-800 group-hover:text-primary-700 dark:text-gray-200 dark:group-hover:text-primary-300" data-i18n="home.allResources">
                  Tots els recursos
                </span>
                <span class="font-mono text-[12px] text-gray-400 group-hover:text-primary-600" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- D. Calculadora -->
        <div class="py-8 lg:px-8">
          <div class="flex items-baseline gap-3">
            <span class="eyebrow">04</span>
            <h2 class="text-[15px] font-semibold" data-i18n="home.s4">Calculadora de notes</h2>
          </div>
          <p class="mt-4 font-mono text-[14px] leading-relaxed text-gray-900 dark:text-gray-100">
            N = max(0,4 × P + 0,6 × F, F)
          </p>
          <p class="mt-2 text-[13px] leading-relaxed text-gray-500 dark:text-gray-400" data-i18n="home.calcNote">
            Introdueix les notes de parcial i final i obtén la nota global, amb el que necessites al
            final per a un 5.0 i per a un 7.0.
          </p>
          <a href="/avaluacio" class="btn btn-secondary mt-4" data-i18n="home.calcOpen">
            Obre la calculadora →
          </a>
        </div>

        <!-- E. Aula lliure -->
        <div class="py-8 lg:pl-8">
          <div class="flex items-baseline gap-3">
            <span class="eyebrow">05</span>
            <h2 class="text-[15px] font-semibold" data-i18n="home.s5">Aula lliure</h2>
          </div>
          <dl class="mt-3 font-mono text-[13px] text-gray-600 dark:text-gray-300">
            <div class="flex justify-between gap-3 border-b border-gray-200 py-2 dark:border-gray-800">
              <dt class="text-gray-400" data-i18n="home.when">Quan</dt>
              <dd data-i18n="sessions.subtitle">Divendres 12:00 - 14:00 - Aula B5S202.</dd>
            </div>
            <div class="flex justify-between gap-3 border-b border-gray-200 py-2 dark:border-gray-800">
              <dt class="text-gray-400" data-i18n="home.where">On</dt>
              <dd>Aula B5S202</dd>
            </div>
            <div class="flex justify-between gap-3 py-2">
              <dt class="text-gray-400" data-i18n="home.sessionCount">Sessions</dt>
              <dd>10</dd>
            </div>
          </dl>
          <a href="/sessions" class="btn btn-secondary mt-4" data-i18n="home.sessionsCta">
            Calendari de sessions →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  // Dates dels exàmens (mateixes que la resta del portal)
  function updateCountdowns() {
    const now = new Date();
    const parcial = new Date('2026-10-29T15:30:00');
    const final = new Date('2027-01-08T08:00:00');

    const diffParcial = Math.ceil((parcial - now) / (1000 * 60 * 60 * 24));
    const diffFinal = Math.ceil((final - now) / (1000 * 60 * 60 * 24));

    const elParcial = document.getElementById('countdown-parcial');
    const elFinal = document.getElementById('countdown-final');
    const rowParcial = document.getElementById('parcial-row');

    if (elParcial) elParcial.textContent = diffParcial > 0 ? String(diffParcial) : '0';
    if (elFinal) elFinal.textContent = diffFinal > 0 ? String(diffFinal) : '0';
    if (rowParcial) rowParcial.style.display = diffParcial > 0 ? '' : 'none';
  }

  updateCountdowns();
  setInterval(updateCountdowns, 60000);

  // Temes encara no publicats: mateixa regla que al temari
  (() => {
    const now = Date.now();
    let professor = false;
    try {
      const session = JSON.parse(localStorage.getItem('pro1_session') || 'null');
      professor = Boolean(session && session.role === 'professor');
    } catch (e) {
      professor = false;
    }

    document.querySelectorAll('li[data-unlock-date]').forEach(row => {
      const unlock = new Date(row.getAttribute('data-unlock-date') + 'T00:00:00').getTime();
      if (professor || now >= unlock) return;
      const link = row.querySelector('a');
      const mark = row.querySelector('.lock-mark');
      if (link) {
        link.removeAttribute('href');
        link.classList.add('pointer-events-none', 'opacity-60');
        link.setAttribute('aria-disabled', 'true');
        link.setAttribute('tabindex', '-1');
      }
      if (mark) mark.classList.remove('hidden');
    });
  })();
</script>
