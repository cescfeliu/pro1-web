---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import GradeCalculator from '../components/GradeCalculator.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Avaluació i calculadora de notes — PRO1 G40 — Aula Lliure"
  description="Fórmula d'avaluació de PRO1 i calculadora de notes amb la nota global i el necessari a l'examen final."
>
  <Navbar />

  <main id="main">
    <section class="border-b border-gray-300 dark:border-gray-800">
      <div class="shell py-8 sm:py-10">
        <p class="eyebrow">
          <span>04</span>
          <span class="mx-1.5 text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span data-i18n="nav.avaluacio">Avaluació</span>
        </p>
        <h1 class="page-title mt-3" data-i18n="avaluacio.title">Avaluació</h1>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400" data-i18n="avaluacio.subtitle">
          Fórmula oficial i calculadora de notes de PRO1.
        </p>
      </div>
    </section>

    <div class="shell grid items-start gap-10 py-8 lg:grid-cols-[minmax(0,1fr)_25rem]">
      <!-- Fórmula -->
      <div>
        <div class="section-head">
          <h2 class="text-[15px] font-semibold" data-i18n="avaluacio.formula">
            Fórmula d'avaluació
          </h2>
          <span class="eyebrow">N</span>
        </div>

        <p class="mt-5 border border-gray-300 bg-white px-4 py-3 font-mono text-[17px] text-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-50">
          N = max(0,4 × P + 0,6 × F, F)
        </p>

        <dl class="mt-5 text-[14px]">
          <div class="flex gap-4 border-b border-gray-200 py-2.5 dark:border-gray-800">
            <dt class="w-6 shrink-0 font-mono text-[13px] text-primary-700 dark:text-primary-300">P</dt>
            <dd class="text-gray-600 dark:text-gray-400" data-i18n="avaluacio.notaP">
              nota de l'examen parcial (sobre 10)
            </dd>
          </div>
          <div class="flex gap-4 border-b border-gray-200 py-2.5 dark:border-gray-800">
            <dt class="w-6 shrink-0 font-mono text-[13px] text-primary-700 dark:text-primary-300">F</dt>
            <dd class="text-gray-600 dark:text-gray-400" data-i18n="avaluacio.notaF">
              nota de l'examen final (sobre 10)
            </dd>
          </div>
          <div class="flex gap-4 border-b border-gray-200 py-2.5 dark:border-gray-800">
            <dt class="w-6 shrink-0 font-mono text-[13px] text-primary-700 dark:text-primary-300">N</dt>
            <dd class="text-gray-600 dark:text-gray-400" data-i18n="avaluacio.notaN">
              nota global de l'assignatura
            </dd>
          </div>
        </dl>

        <div class="mt-5 border-l-2 border-amber-300 pl-4 dark:border-amber-800">
          <p class="eyebrow" data-i18n="avaluacio.npTitle">Nota NP:</p>
          <p class="mt-1.5 text-[14px] leading-relaxed text-gray-600 dark:text-gray-400" data-i18n="avaluacio.npText">
            Un examen tindrà nota NP si no s'ha fet cap entrega a cap dels seus problemes. La nota
            global N serà NP si ambdós exàmens (parcial i final) tenen nota NP.
          </p>
        </div>
      </div>

      <!-- Calculadora -->
      <GradeCalculator />
    </div>
  </main>

  <Footer />
</Layout>
