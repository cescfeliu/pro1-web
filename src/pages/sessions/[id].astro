---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { sessionPlans } from '../../data/sessionPlans';

export function getStaticPaths() {
  return sessionPlans.map(plan => ({
    params: { id: String(plan.id) },
    props: { plan },
  }));
}

const { plan } = Astro.props;
const title = plan.title ? `Sessió ${plan.id}: ${plan.title}` : `Sessió ${plan.id}`;
const date = `${plan.date} · 12:00 – 14:00 · Aula B5S202`;
---

<Layout
  title={`${title} — PRO1 G40 — Aula Lliure`}
  description={`Pla de la ${title} — PRO1 G40, Aula Lliure.`}
>
  <Navbar />

  <main id="main">
    <div class="shell py-8">
      <a
        href="/sessions"
        class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gray-500 transition-colors hover:text-primary-700 dark:text-gray-400 dark:hover:text-primary-300"
      >
        <span aria-hidden="true">←</span>
        <span data-i18n="sessions.back">Tornar a les sessions</span>
      </a>

      <!-- Avis per a qui no té accés encara -->
      <div id="plan-locked" class="mt-6 border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-900">
        <p class="eyebrow" data-i18n="nav.sessions">Sessions</p>
        <h1 class="doc-title mt-3">{title}</h1>
        <p class="mt-3 max-w-prose2 text-[14px] text-gray-600 dark:text-gray-400" data-i18n="sessions.planPending">
          Aquesta sessió encara no s'ha publicat. Consulta-la més endavant.
        </p>
        <a href="/sessions" class="btn btn-secondary mt-6" data-i18n="sessions.back">
          Tornar a les sessions
        </a>
      </div>

      <article id="plan" class="hidden">
        <header class="mt-6 border-b border-gray-300 pb-6 dark:border-gray-800">
          <div class="flex flex-wrap items-center gap-2">
            {
              !plan.published && (
                <span class="badge border-amber-300 text-amber-700 dark:border-amber-800 dark:text-amber-300">
                  Només professor
                </span>
              )
            }
            {!plan.published && <span class="eyebrow">Esborrador · previsualització</span>}
          </div>
          <h1 class="doc-title mt-3">{title}</h1>
          <p class="mt-2 font-mono text-[12px] text-gray-500 dark:text-gray-400">{date}</p>
        </header>

        <div class="max-w-[46rem]">
          {
            plan.id === 1 && (
              <>
                {/* 1. Treball previ */}
                <section class="mt-8">
                  <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                    <span class="eyebrow shrink-0">1</span>
                    <h2 class="text-[17px] font-semibold">Treball previ</h2>
                  </div>
                  <p class="mt-4 text-[14px] text-gray-700 dark:text-gray-300">
                    Repassar el tema 1 i 2, i el tema 4:
                  </p>
                  <ul class="mt-2">
                    <li class="flex gap-3 border-b border-gray-100 py-2 text-[14px] text-gray-700 dark:border-gray-800/60 dark:text-gray-300">
                      <span class="font-mono text-[12px] text-primary-600 dark:text-primary-400">01</span>
                      <span>
                        <strong class="font-semibold text-gray-900 dark:text-gray-100">Tema 1:</strong>{' '}
                        Introducció als principis bàsics de la programació.
                      </span>
                    </li>
                    <li class="flex gap-3 border-b border-gray-100 py-2 text-[14px] text-gray-700 dark:border-gray-800/60 dark:text-gray-300">
                      <span class="font-mono text-[12px] text-primary-600 dark:text-primary-400">02</span>
                      <span>
                        <strong class="font-semibold text-gray-900 dark:text-gray-100">Tema 2:</strong>{' '}
                        Dades i instruccions.
                      </span>
                    </li>
                    <li class="flex gap-3 py-2 text-[14px] text-gray-700 dark:text-gray-300">
                      <span class="font-mono text-[12px] text-primary-600 dark:text-primary-400">03</span>
                      <span>
                        <strong class="font-semibold text-gray-900 dark:text-gray-100">Tema 4:</strong>{' '}
                        Tipus de dades. Visibilitat de variables.
                      </span>
                    </li>
                  </ul>
                </section>

                {/* 2. Objectius */}
                <section class="mt-9 border-t border-gray-200 pt-6 dark:border-gray-800">
                  <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                    <span class="eyebrow shrink-0">2</span>
                    <h2 class="text-[17px] font-semibold">Objectius de la sessió</h2>
                  </div>
                  <ul class="mt-3">
                    <li class="flex gap-3 border-b border-gray-100 py-2 text-[14px] text-gray-700 dark:border-gray-800/60 dark:text-gray-300">
                      <span class="font-mono text-[12px] text-primary-600 dark:text-primary-400">–</span>
                      <span>Introducció a l'Aula Lliure.</span>
                    </li>
                    <li class="flex gap-3 py-2 text-[14px] text-gray-700 dark:text-gray-300">
                      <span class="font-mono text-[12px] text-primary-600 dark:text-primary-400">–</span>
                      <span>
                        Introducció a C++ (tipus de dades, variables, E/S, condicionals i operadors).
                      </span>
                    </li>
                  </ul>
                </section>

                {/* 3. Pla de la classe */}
                <section class="mt-9 border-t border-gray-200 pt-6 dark:border-gray-800">
                  <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                    <span class="eyebrow shrink-0">3</span>
                    <h2 class="text-[17px] font-semibold">Pla de la classe</h2>
                  </div>

                  <div class="mt-4 flex flex-col gap-6">
                    <div class="border-l-2 border-gray-300 pl-4 dark:border-gray-700">
                      <p class="font-mono text-[13px] font-medium text-primary-700 dark:text-primary-300">
                        Bloc 1: Presentació + presa de contacte
                      </p>
                      <ul class="mt-2 space-y-1.5 text-[14px] text-gray-700 dark:text-gray-300">
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>Presentació i dades de contacte.</span>
                        </li>
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>Presentació de la pàgina web i de l'Aula Lliure.</span>
                        </li>
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>Preguntar què us preocupa i com voleu que enfoqui les classes.</span>
                        </li>
                      </ul>
                    </div>

                    <div class="border-l-2 border-gray-300 pl-4 dark:border-gray-700">
                      <p class="font-mono text-[13px] font-medium text-primary-700 dark:text-primary-300">
                        Bloc 2: Repàs teòric T1, T2 i T4 · Introducció a C++
                      </p>
                      <ul class="mt-2 space-y-1.5 text-[14px] text-gray-700 dark:text-gray-300">
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>
                            Repàs ràpid de variables, tipus de dades, expressions i condicionals
                            (temes 1 i 2).
                          </span>
                        </li>
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>Tema 4: tipus de dades i visibilitat de variables.</span>
                        </li>
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>
                            Introducció a C++: tipus de dades, variables, E/S, condicionals i
                            operadors.
                          </span>
                        </li>
                      </ul>
                    </div>

                    <div class="border-l-2 border-gray-300 pl-4 dark:border-gray-700">
                      <p class="font-mono text-[13px] font-medium text-primary-700 dark:text-primary-300">
                        Bloc 3: Començar a practicar
                      </p>
                      <ul class="mt-2 space-y-2.5 text-[14px] text-gray-700 dark:text-gray-300">
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span class="min-w-0 flex-1">
                            Exercicis:
                            <span class="mt-2 flex flex-wrap gap-2">
                              <span class="inline-flex items-center gap-2 border border-gray-200 px-2 py-1 text-[12px] text-gray-600 dark:border-gray-700 dark:text-gray-300">
                                <span class="font-mono font-medium text-primary-700 dark:text-primary-300">P99182</span>
                                <span>Promedio</span>
                              </span>
                              <span class="inline-flex items-center gap-2 border border-gray-200 px-2 py-1 text-[12px] text-gray-600 dark:border-gray-700 dark:text-gray-300">
                                <span class="font-mono font-medium text-primary-700 dark:text-primary-300">P42042</span>
                                <span>Classificació de caràcters (1)</span>
                              </span>
                              <span class="inline-flex items-center gap-2 border border-gray-200 px-2 py-1 text-[12px] text-gray-600 dark:border-gray-700 dark:text-gray-300">
                                <span class="font-mono font-medium text-primary-700 dark:text-primary-300">P61634</span>
                                <span>Anys de traspàs</span>
                              </span>
                            </span>
                          </span>
                        </li>
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>Aprofitar per resoldre dubtes previs.</span>
                        </li>
                      </ul>
                    </div>

                    <div class="border-l-2 border-gray-300 pl-4 dark:border-gray-700">
                      <p class="font-mono text-[13px] font-medium text-primary-700 dark:text-primary-300">
                        Bloc 4: Exercicis de consolidació
                      </p>
                      <div class="mt-2 flex flex-wrap gap-2">
                        <span class="inline-flex max-w-full items-center gap-2 border border-gray-200 px-2 py-1 text-[12px] text-gray-600 dark:border-gray-700 dark:text-gray-300">
                          <span class="font-mono font-medium text-primary-700 dark:text-primary-300">X29232</span>
                          <span>Donats quatre enters, comprovar que dos son iguals i dos son diferents</span>
                        </span>
                        <span class="inline-flex max-w-full items-center gap-2 border border-gray-200 px-2 py-1 text-[12px] text-gray-600 dark:border-gray-700 dark:text-gray-300">
                          <span class="font-mono font-medium text-primary-700 dark:text-primary-300">X81984</span>
                          <span>Donats tres nombres, comprova si algun d'ells és igual al promig dels altres dos</span>
                        </span>
                      </div>
                    </div>
                  </div>
                </section>

                {/* 4. Post-classe */}
                <section class="mt-9 border-t border-gray-200 pt-6 dark:border-gray-800">
                  <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                    <span class="eyebrow shrink-0">4</span>
                    <h2 class="text-[17px] font-semibold">Post-classe</h2>
                  </div>
                  <dl class="mt-3 text-[14px]">
                    <div class="flex gap-3 border-b border-gray-100 py-2 dark:border-gray-800/60">
                      <dt class="w-48 shrink-0 font-medium text-gray-900 dark:text-gray-100">
                        Resum del que s'ha fet:
                      </dt>
                      <dd class="text-gray-500 dark:text-gray-400">-</dd>
                    </div>
                    <div class="flex gap-3 border-b border-gray-100 py-2 dark:border-gray-800/60">
                      <dt class="w-48 shrink-0 font-medium text-gray-900 dark:text-gray-100">
                        Arxius i recursos adjunts:
                      </dt>
                      <dd class="text-gray-500 dark:text-gray-400">-</dd>
                    </div>
                    <div class="flex gap-3 py-2">
                      <dt class="w-48 shrink-0 font-medium text-gray-900 dark:text-gray-100">
                        Feina a fer:
                      </dt>
                      <dd class="text-gray-500 dark:text-gray-400">-</dd>
                    </div>
                  </dl>
                </section>
              </>
            )
          }

          {
            plan.id === 2 && (
              <>
                {/* 1. Treball previ */}
                <section class="mt-8">
                  <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                    <span class="eyebrow shrink-0">1</span>
                    <h2 class="text-[17px] font-semibold">Treball previ</h2>
                  </div>
                  <p class="mt-4 text-[14px] text-gray-700 dark:text-gray-300">
                    Repassar el tema 3:
                  </p>
                  <ul class="mt-2">
                    <li class="flex gap-3 py-2 text-[14px] text-gray-700 dark:text-gray-300">
                      <span class="font-mono text-[12px] text-primary-600 dark:text-primary-400">01</span>
                      <span>
                        <strong class="font-semibold text-gray-900 dark:text-gray-100">Tema 3:</strong>{' '}
                        Iteracions.
                      </span>
                    </li>
                  </ul>
                </section>

                {/* 2. Objectius */}
                <section class="mt-9 border-t border-gray-200 pt-6 dark:border-gray-800">
                  <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                    <span class="eyebrow shrink-0">2</span>
                    <h2 class="text-[17px] font-semibold">Objectius de la sessió</h2>
                  </div>
                  <ul class="mt-3">
                    <li class="flex gap-3 border-b border-gray-100 py-2 text-[14px] text-gray-700 dark:border-gray-800/60 dark:text-gray-300">
                      <span class="font-mono text-[12px] text-primary-600 dark:text-primary-400">–</span>
                      <span>Dominar bucles for i while.</span>
                    </li>
                    <li class="flex gap-3 py-2 text-[14px] text-gray-700 dark:text-gray-300">
                      <span class="font-mono text-[12px] text-primary-600 dark:text-primary-400">–</span>
                      <span>Entendre quan fer ús de l'un o de l'altre.</span>
                    </li>
                  </ul>
                </section>

                {/* 3. Pla de la classe */}
                <section class="mt-9 border-t border-gray-200 pt-6 dark:border-gray-800">
                  <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                    <span class="eyebrow shrink-0">3</span>
                    <h2 class="text-[17px] font-semibold">Pla de la classe</h2>
                  </div>

                  <div class="mt-4 flex flex-col gap-6">
                    <div class="border-l-2 border-gray-300 pl-4 dark:border-gray-700">
                      <p class="font-mono text-[13px] font-medium text-primary-700 dark:text-primary-300">
                        Bloc 1: Repàs teòric T3 · Iteracions
                      </p>
                      <ul class="mt-2 space-y-1.5 text-[14px] text-gray-700 dark:text-gray-300">
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>Repàs dels continguts del tema 3.</span>
                        </li>
                      </ul>
                    </div>

                    <div class="border-l-2 border-gray-300 pl-4 dark:border-gray-700">
                      <p class="font-mono text-[13px] font-medium text-primary-700 dark:text-primary-300">
                        Bloc 2: Començar a practicar
                      </p>
                      <ul class="mt-2 space-y-2.5 text-[14px] text-gray-700 dark:text-gray-300">
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span class="min-w-0 flex-1">
                            Exercicis:
                            <span class="mt-2 block text-[13px] text-gray-400 italic dark:text-gray-500">
                              (Pendent de concretar)
                            </span>
                          </span>
                        </li>
                      </ul>
                    </div>

                    <div class="border-l-2 border-gray-300 pl-4 dark:border-gray-700">
                      <p class="font-mono text-[13px] font-medium text-primary-700 dark:text-primary-300">
                        Bloc 3: Resoldre dubtes
                      </p>
                      <ul class="mt-2 space-y-1.5 text-[14px] text-gray-700 dark:text-gray-300">
                        <li class="flex gap-3">
                          <span class="font-mono text-primary-600 dark:text-primary-400">–</span>
                          <span>Resoldre els dubtes que tingueu.</span>
                        </li>
                      </ul>
                    </div>
                  </div>
                </section>

                {/* 4. Post-classe */}
                <section class="mt-9 border-t border-gray-200 pt-6 dark:border-gray-800">
                  <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                    <span class="eyebrow shrink-0">4</span>
                    <h2 class="text-[17px] font-semibold">Post-classe</h2>
                  </div>
                  <dl class="mt-3 text-[14px]">
                    <div class="flex gap-3 border-b border-gray-100 py-2 dark:border-gray-800/60">
                      <dt class="w-48 shrink-0 font-medium text-gray-900 dark:text-gray-100">
                        Resum del que s'ha fet:
                      </dt>
                      <dd class="text-gray-500 dark:text-gray-400">-</dd>
                    </div>
                    <div class="flex gap-3 border-b border-gray-100 py-2 dark:border-gray-800/60">
                      <dt class="w-48 shrink-0 font-medium text-gray-900 dark:text-gray-100">
                        Arxius i recursos adjunts:
                      </dt>
                      <dd class="text-gray-500 dark:text-gray-400">-</dd>
                    </div>
                    <div class="flex gap-3 py-2">
                      <dt class="w-48 shrink-0 font-medium text-gray-900 dark:text-gray-100">
                        Feina a fer:
                      </dt>
                      <dd class="text-gray-500 dark:text-gray-400">-</dd>
                    </div>
                  </dl>
                </section>
              </>
            )
          }
        </div>
      </article>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ published: plan.published }}>
  (() => {
    let professor = false;
    try {
      const session = JSON.parse(localStorage.getItem('pro1_session') || 'null');
      professor = Boolean(session && session.role === 'professor');
    } catch (e) {
      professor = false;
    }
    const canView = professor || published;
    document.getElementById('plan')?.classList.toggle('hidden', !canView);
    document.getElementById('plan-locked')?.classList.toggle('hidden', canView);
  })();
</script>
