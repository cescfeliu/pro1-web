---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Sessions — PRO1 G40 — Aula Lliure"
  description="Calendari de les sessions de l'aula lliure de PRO1: divendres de 12:00 a 14:00, aula B5S202."
>
  <Navbar />

  <main id="main">
    <section class="border-b border-gray-300 dark:border-gray-800">
      <div class="shell py-8 sm:py-10">
        <p class="eyebrow">
          <span>06</span>
          <span class="mx-1.5 text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span data-i18n="nav.sessions">Sessions</span>
        </p>
        <h1 class="page-title mt-3" data-i18n="sessions.title">Sessions</h1>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400" data-i18n="sessions.subtitle">
          Divendres 12:00 - 14:00 - Aula B5S202.
        </p>
      </div>
    </section>

    <div class="shell py-6">
      <div
        class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-300 pb-3 dark:border-gray-800"
      >
        <p class="eyebrow" data-i18n="sessions.planTitle">Calendari</p>
        <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-gray-400 dark:text-gray-500">
          2026 / 2027
        </p>
      </div>

      <div id="sessions-container" class="grid gap-x-10 sm:grid-cols-2"></div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { sessionPlans } from '../data/sessionPlans';

  const sessionsData = [
    { date: '9 octubre 2026', dateEs: '9 octubre 2026', dateEn: 'October 9, 2026', number: 1 },
    { date: '16 octubre 2026', dateEs: '16 octubre 2026', dateEn: 'October 16, 2026', number: 2 },
    { date: '23 octubre 2026', dateEs: '23 octubre 2026', dateEn: 'October 23, 2026', number: 3 },
    { date: '29/10/2026 (15:30 i 18:00)', dateEs: '29/10/2026 (15:30 y 18:00)', dateEn: '29/10/2026 (15:30 & 18:00)', number: null, special: 'Parcials', specialEs: 'Parciales', specialEn: 'Midterms' },
    { date: '6 novembre 2026', dateEs: '6 noviembre 2026', dateEn: 'November 6, 2026', number: 4 },
    { date: '13 novembre 2026', dateEs: '13 noviembre 2026', dateEn: 'November 13, 2026', number: 5 },
    { date: '20 novembre 2026', dateEs: '20 noviembre 2026', dateEn: 'November 20, 2026', number: 6 },
    { date: '27 novembre 2026', dateEs: '27 noviembre 2026', dateEn: 'November 27, 2026', number: 7 },
    { date: '4 desembre 2026', dateEs: '4 diciembre 2026', dateEn: 'December 4, 2026', number: 8 },
    { date: '11 desembre 2026', dateEs: '11 diciembre 2026', dateEn: 'December 11, 2026', number: 9 },
    { date: '18 desembre 2026', dateEs: '18 diciembre 2026', dateEn: 'December 18, 2026', number: 10 },
    { date: '08/01/2027 (08:00 i 11:30)', dateEs: '08/01/2027 (08:00 y 11:30)', dateEn: '08/01/2027 (08:00 & 11:30)', number: null, special: 'Finals', specialEs: 'Finales', specialEn: 'Finals' }
  ];

  const sessionTranslations = {
    ca: { planificacio: 'Planificació a confirmar', sessio: 'Sessió', veurePla: 'Veure pla' },
    es: { planificacio: 'Planificación a confirmar', sessio: 'Sesión', veurePla: 'Ver plan' },
    en: { planificacio: 'Schedule to be confirmed', sessio: 'Session', veurePla: 'View plan' }
  };

  function isProfessor() {
    try {
      const session = JSON.parse(localStorage.getItem('pro1_session') || 'null');
      return Boolean(session && session.role === 'professor');
    } catch (e) {
      return false;
    }
  }

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined && text !== null) node.textContent = String(text);
    return node;
  }

  const ROW = 'group flex items-start gap-4 border-b border-gray-200 py-3.5 dark:border-gray-800';

  function renderSessions() {
    const lang = localStorage.getItem('lang') || 'ca';
    const t = sessionTranslations[lang] || sessionTranslations.ca;
    const container = document.getElementById('sessions-container');
    if (!container) return;

    const professor = isProfessor();
    container.replaceChildren();

    sessionsData.forEach(session => {
      const date = lang === 'es' ? session.dateEs : lang === 'en' ? session.dateEn : session.date;
      const special = session.special
        ? lang === 'es'
          ? session.specialEs
          : lang === 'en'
            ? session.specialEn
            : session.special
        : null;
      const isExam = Boolean(special);

      const plan = sessionPlans.find(p => p.id === session.number);
      const canOpen = Boolean(plan) && (professor || plan.published);

      const row = el(canOpen ? 'a' : 'div', ROW);
      if (canOpen) row.setAttribute('href', `/sessions/${session.number}`);
      if (!isExam) {
        row.setAttribute(
          'data-searchable',
          `${session.number ? `Sessió ${session.number}` : ''} ${date} ${plan && plan.title ? plan.title : ''}`
        );
      }

      const mark = el(
        'span',
        isExam
          ? 'w-8 shrink-0 pt-0.5 font-mono text-[13px] font-medium ' +
              (session.special === 'Finals'
                ? 'text-red-600 dark:text-red-400'
                : 'text-amber-600 dark:text-amber-400')
          : 'w-8 shrink-0 pt-0.5 font-mono text-[13px] tabular-nums text-gray-400 dark:text-gray-500',
        isExam ? '!!' : String(session.number).padStart(2, '0')
      );
      row.appendChild(mark);

      const body = el('span', 'min-w-0 flex-1');

      if (isExam) {
        body.appendChild(
          el(
            'span',
            'block text-[14px] font-medium text-gray-900 dark:text-gray-100',
            special
          )
        );
        body.appendChild(
          el('span', 'mt-0.5 block font-mono text-[12px] text-gray-500 dark:text-gray-400', date)
        );
      } else {
        body.appendChild(
          el(
            'span',
            'block text-[14px] font-medium text-gray-900 transition-colors duration-150 group-hover:text-primary-700 dark:text-gray-100 dark:group-hover:text-primary-300',
            `${t.sessio} ${session.number}`
          )
        );
        body.appendChild(
          el('span', 'mt-0.5 block font-mono text-[12px] text-gray-500 dark:text-gray-400', date)
        );
        if (canOpen && plan.title) {
          body.appendChild(
            el('span', 'mt-1 block text-[13px] text-gray-600 dark:text-gray-400', plan.title)
          );
        } else if (!canOpen) {
          body.appendChild(
            el('span', 'mt-1 block text-[13px] text-gray-400 dark:text-gray-500', t.planificacio)
          );
        }
      }

      row.appendChild(body);

      if (canOpen && !isExam) {
        row.appendChild(
          el(
            'span',
            'shrink-0 pt-0.5 font-mono text-[13px] text-gray-300 transition-colors duration-150 group-hover:text-primary-600 dark:text-gray-600 dark:group-hover:text-primary-400',
            '→'
          )
        );
      }

      container.appendChild(row);
    });
  }

  renderSessions();
  window.addEventListener('lang-changed', renderSessions);
</script>
