---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import topics from '../../data/topics.json';
import { isLockedForever, unlockDates } from '../../data/unlock';

export function getStaticPaths() {
  return topics.map(topic => ({
    params: { id: topic.id.toString() },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const unlockDate = unlockDates[topic.scope];
const lockedForever = isLockedForever(topic.scope);
const unlockLabel =
  unlockDate && !lockedForever
    ? new Date(`${unlockDate}T00:00:00`).toLocaleDateString('ca-ES')
    : '';
const lockMessage = unlockLabel
  ? `Aquest tema estarà disponible el ${unlockLabel}.`
  : 'Aquest tema encara no està publicat.';

const sections = topic.theory?.sections ?? [];
const sources = topic.sources ?? [];
const hasIndex =
  sections.length > 0 || Boolean(topic.template) || (topic.commonErrors?.length ?? 0) > 0;
const prev = topics.find(t => t.id === topic.id - 1);
const next = topics.find(t => t.id === topic.id + 1);

const KEYWORDS =
  'alignas|alignof|and|asm|auto|bool|break|case|catch|char|class|const|constexpr|continue|default|delete|do|double|dynamic_cast|else|enum|explicit|export|extern|false|float|for|friend|goto|if|inline|int|long|mutable|namespace|new|noexcept|not|nullptr|operator|or|private|protected|public|register|reinterpret_cast|return|short|signed|sizeof|static|static_cast|struct|switch|template|this|throw|true|try|typedef|typeid|typename|union|unsigned|using|virtual|void|volatile|while|std|string|vector|cin|cout|cerr|endl|size_t|getline|push_back|size|empty|main';

function escapeHtml(value: string) {
  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function escapeAttr(value: string) {
  return escapeHtml(value).replace(/"/g, '&quot;');
}

function highlightCpp(escaped: string) {
  const re = new RegExp(
    '(\\/\\/[^\\n]*|\\/\\*[\\s\\S]*?\\*\\/)' + // 1. comentaris
      '|("(?:\\\\.|[^"\\\\])*"|\'(?:\\\\.|[^\'\\\\])*\')' + // 2. cadenes i caràcters
      '|(#[a-zA-Z_]+)' + // 3. preprocessor
      '|\\b(' +
      KEYWORDS +
      ')\\b' + // 4. paraules clau
      '|\\b(\\d+(?:\\.\\d+)?)\\b', // 5. números
    'g'
  );
  return escaped.replace(re, (match, comment, str, pre, keyword, num) => {
    if (comment) return `<span class="tok-c">${comment}</span>`;
    if (str) return `<span class="tok-s">${str}</span>`;
    if (pre) return `<span class="tok-p">${pre}</span>`;
    if (keyword) return `<span class="tok-k">${keyword}</span>`;
    if (num) return `<span class="tok-s">${num}</span>`;
    return match;
  });
}

function renderInline(escaped: string) {
  return escaped
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/`([^`]+)`/g, '<code class="code-inline">$1</code>');
}

function renderText(chunk: string) {
  return chunk
    .split(/\n{2,}/)
    .map(block => {
      const lines = block.split('\n');
      if (lines.length && lines.every(line => /^\s*[-*]\s+/.test(line))) {
        const items = lines
          .map(line => `<li>${renderInline(escapeHtml(line.replace(/^\s*[-*]\s+/, '')))}</li>`)
          .join('');
        return `<ul>${items}</ul>`;
      }
      if (lines.length && lines.every(line => /^\s*\d+[.)]\s+/.test(line))) {
        const items = lines
          .map(line => `<li>${renderInline(escapeHtml(line.replace(/^\s*\d+[.)]\s+/, '')))}</li>`)
          .join('');
        return `<ol>${items}</ol>`;
      }
      return `<p>${renderInline(escapeHtml(lines.join(' ')))}</p>`;
    })
    .join('');
}

function renderCode(code: string, lang: string) {
  const label = (lang || 'codi').toUpperCase();
  return (
    '<div class="code-wrap my-4">' +
    `<div class="code-head"><span>${label}</span>` +
    `<button type="button" class="copy-code transition-colors hover:text-gray-100" data-i18n="code.copy">Copiar codi</button></div>` +
    `<pre class="code-block border-t-0"><code>${highlightCpp(escapeHtml(code))}</code></pre>` +
    '</div>'
  );
}

function renderContent(content: string) {
  const parts = content.split('```');
  return parts
    .map((part, index) => {
      if (index % 2 === 0) return renderText(part);
      const nl = part.indexOf('\n');
      const lang = nl === -1 ? '' : part.slice(0, nl).trim();
      const code = (nl === -1 ? '' : part.slice(nl + 1)).replace(/\n$/, '');
      return renderCode(code, lang);
    })
    .join('');
}
---

<Layout
  title={`${topic.title} — Tema ${topic.id} — PRO1 G40`}
  description={`Tema ${topic.id} de PRO1: ${topic.summary}`}
>
  <Navbar />

  <main id="main">
    <script is:inline define:vars={{ unlockDate, lockedForever }}>
      let unlocked = false;
      try {
        const session = JSON.parse(localStorage.getItem('pro1_session') || 'null');
        if (session && session.role === 'professor') unlocked = true;
      } catch (e) {
        /* ignore */
      }
      if (!unlocked && !lockedForever) {
        unlocked = !unlockDate || Date.now() >= new Date(unlockDate + 'T00:00:00').getTime();
      }
      if (unlocked) {
        document.documentElement.classList.add('topic-unlocked');
      }
    </script>

    <!-- Contingut bloquejat -->
    <div class="topic-lock-screen shell py-16">
      <div class="mx-auto max-w-md border border-gray-200 bg-white p-8 text-center dark:border-gray-800 dark:bg-gray-900">
        <p class="eyebrow" data-i18n="nav.temari">Temari</p>
        <h1 class="doc-title mt-3" data-i18n="tema.lockedTitle">Contingut bloquejat</h1>
        <p class="mt-3 text-[14px] text-gray-600 dark:text-gray-400">
          {lockMessage}
        </p>
        <a href="/temari" class="btn btn-secondary mt-6" data-i18n="tema.tornar">Tornar al temari</a>
      </div>
    </div>

    <div class="topic-page-content">
      <div class="shell grid gap-x-12 lg:grid-cols-[13rem_minmax(0,1fr)]">
        <!-- Índex lateral -->
        {hasIndex && (
        <aside class="hidden lg:block">
          <nav class="sticky top-20 pt-9" aria-label="Índex del tema">
            <p class="eyebrow border-b border-gray-300 pb-2 dark:border-gray-800">
              <span data-i18n="tema.index">Índex</span>
            </p>
            <ol class="mt-2 space-y-1.5 text-[13px]">
              {
                sections.map((section: any, index: number) => (
                  <li>
                    <a
                      href={`#s${index + 1}`}
                      class="flex gap-2 text-gray-600 transition-colors hover:text-primary-700 dark:text-gray-400 dark:hover:text-primary-300"
                    >
                      <span class="font-mono text-[12px] tabular-nums text-gray-400 dark:text-gray-500">
                        {index + 1}
                      </span>
                      <span class="min-w-0 truncate">{section.title}</span>
                    </a>
                  </li>
                ))
              }
              {
                topic.commonErrors?.length > 0 && (
                  <li>
                    <a
                      href="#errors"
                      class="flex gap-2 text-gray-600 transition-colors hover:text-primary-700 dark:text-gray-400 dark:hover:text-primary-300"
                    >
                      <span class="font-mono text-[12px] text-gray-400 dark:text-gray-500">!</span>
                      <span data-i18n="tema.errors">Errors típics</span>
                    </a>
                  </li>
                )
              }
              {
                topic.template && (
                  <li>
                    <a
                      href="#plantilla"
                      class="flex gap-2 text-gray-600 transition-colors hover:text-primary-700 dark:text-gray-400 dark:hover:text-primary-300"
                    >
                      <span class="font-mono text-[12px] text-gray-400 dark:text-gray-500">#</span>
                      <span data-i18n="tema.plantilla">Plantilla C++</span>
                    </a>
                  </li>
                )
              }
            </ol>
          </nav>
        </aside>
        )}

        <!-- Contingut -->
        <div class="min-w-0 max-w-[46rem] pb-6 pt-8">
          <a
            href="/temari"
            class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gray-500 transition-colors hover:text-primary-700 dark:text-gray-400 dark:hover:text-primary-300"
          >
            <span aria-hidden="true">←</span>
            <span data-i18n="tema.tornar">Tornar al temari</span>
          </a>

          <header class="mt-5 border-b border-gray-300 pb-6 dark:border-gray-800">
            <p class="eyebrow flex flex-wrap items-center gap-2">
              <span>Tema {String(topic.id).padStart(2, '0')}</span>
              <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
              <span class:list={[topic.scope === 'Parcial' ? 'badge badge-parcial' : 'badge badge-final']}>
                {topic.scope}
              </span>
            </p>
            <h1 class="doc-title mt-3">{topic.title}</h1>
            <p class="mt-3 text-[15px] leading-relaxed text-gray-600 dark:text-gray-400">
              {topic.summary}
            </p>
            {
              sources.length > 0 && (
                <div class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1.5 text-[13px] leading-relaxed text-gray-600 dark:text-gray-400">
                  <span
                    class="font-mono text-[11px] uppercase tracking-[0.1em] text-gray-400 dark:text-gray-500"
                    data-i18n="tema.credits">
                    Crèdits
                  </span>
                  <span data-i18n="tema.creditsText">Basat en els apunts de</span>
                  <a
                    href="https://apunts-pro1.vercel.app/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link">
                    Pau Fernández
                  </a>
                  {sources.map((source: any) => (
                    <>
                      <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">·</span>
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link">
                        {source.title}
                      </a>
                    </>
                  ))}
                </div>
              )
            }
          </header>

          <!-- Índex en mòbil -->
          {hasIndex && (
          <details class="mt-6 border border-gray-200 p-3 dark:border-gray-800 lg:hidden">
            <summary class="eyebrow cursor-pointer select-none" data-i18n="tema.index">Índex</summary>
            <ol class="mt-3 space-y-1.5 text-[13px]">
              {
                sections.map((section: any, index: number) => (
                  <li>
                    <a
                      href={`#s${index + 1}`}
                      class="flex gap-2 text-gray-600 dark:text-gray-400"
                    >
                      <span class="font-mono text-[12px] tabular-nums text-gray-400">{index + 1}</span>
                      <span>{section.title}</span>
                    </a>
                  </li>
                ))
              }
              {
                topic.commonErrors?.length > 0 && (
                  <li>
                    <a href="#errors" class="flex gap-2 text-gray-600 dark:text-gray-400">
                      <span class="font-mono text-[12px] text-gray-400">!</span>
                      <span data-i18n="tema.errors">Errors típics</span>
                    </a>
                  </li>
                )
              }
              {
                topic.template && (
                  <li>
                    <a href="#plantilla" class="flex gap-2 text-gray-600 dark:text-gray-400">
                      <span class="font-mono text-[12px] text-gray-400">#</span>
                      <span data-i18n="tema.plantilla">Plantilla C++</span>
                    </a>
                  </li>
                )
              }
            </ol>
          </details>
          )}

          <!-- Seccions de teoria -->
          {
            sections.map((section: any, index: number) => (
              <section id={`s${index + 1}`} class="mt-9 scroll-mt-24">
                <div class="flex items-baseline gap-3 border-b border-gray-200 pb-2 dark:border-gray-800">
                  <span class="eyebrow shrink-0">§{index + 1}</span>
                  <h2 class="text-[18px] font-semibold">{section.title}</h2>
                </div>
                <div class="doc mt-4" set:html={renderContent(section.content)} />
              </section>
            ))
          }

          <!-- Errors típics -->
          {
            topic.commonErrors?.length > 0 && (
              <section id="errors" class="mt-10 scroll-mt-24">
                <div class="section-head">
                  <div class="flex items-baseline gap-3">
                    <span class="eyebrow shrink-0">!</span>
                    <h2 class="text-[18px] font-semibold" data-i18n="tema.errors">
                      Errors típics
                    </h2>
                  </div>
                  <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-gray-400">
                    {topic.commonErrors.length}
                  </span>
                </div>
                <ul class="mt-4 space-y-3">
                  {topic.commonErrors.map((error: string) => (
                    <li class="border-l-2 border-red-300 pl-3 dark:border-red-800">
                      <span class="sr-only">Error habitual: </span>
                      <span class="text-[14px] leading-relaxed text-gray-700 dark:text-gray-300">{error}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <!-- Plantilla -->
          {
            topic.template && (
              <section id="plantilla" class="mt-10 scroll-mt-24">
                <div class="section-head">
                  <div class="flex items-baseline gap-3">
                    <span class="eyebrow shrink-0">#</span>
                    <h2 class="text-[18px] font-semibold" data-i18n="tema.plantilla">
                      Plantilla C++
                    </h2>
                  </div>
                </div>
                <div class="code-wrap mt-4">
                  <div class="code-head">
                    <span>C++</span>
                    <button
                      type="button"
                      class="copy-code transition-colors hover:text-gray-100"
                      data-i18n="tema.copiar">Copiar plantilla</button
                    >
                  </div>
                  <pre class="code-block border-t-0"><code>{topic.template}</code></pre>
                </div>
              </section>
            )
          }

          <!-- Navegació entre temes -->
          <nav
            class="mt-12 flex flex-col gap-4 border-t border-gray-300 pt-6 dark:border-gray-800 sm:flex-row sm:justify-between"
            aria-label="Navegació entre temes"
          >
            {
              prev ? (
                <a
                  href={`/tema/${prev.id}`}
                  class="group max-w-xs text-left transition-colors hover:text-primary-700 dark:hover:text-primary-300"
                >
                  <span class="block font-mono text-[11px] uppercase tracking-[0.1em] text-gray-400">
                    <span aria-hidden="true">←</span>
                    <span data-i18n="tema.anterior">Tema anterior</span>
                  </span>
                  <span class="mt-1 block text-[14px] text-gray-700 group-hover:text-primary-700 dark:text-gray-300 dark:group-hover:text-primary-300">
                    {String(prev.id).padStart(2, '0')} · {prev.title}
                  </span>
                </a>
              ) : (
                <span />
              )
            }
            {
              next && (
                <a
                  href={`/tema/${next.id}`}
                  class="group max-w-xs text-right transition-colors hover:text-primary-700 dark:hover:text-primary-300 sm:ml-auto"
                >
                  <span class="block font-mono text-[11px] uppercase tracking-[0.1em] text-gray-400">
                    <span data-i18n="tema.seguent">Tema següent</span>
                    <span aria-hidden="true">→</span>
                  </span>
                  <span class="mt-1 block text-[14px] text-gray-700 group-hover:text-primary-700 dark:text-gray-300 dark:group-hover:text-primary-300">
                    {String(next.id).padStart(2, '0')} · {next.title}
                  </span>
                </a>
              )
            }
          </nav>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  // Copiar blocs de codi (plantilles i exemples)
  document.querySelectorAll('.copy-code').forEach(btn => {
    btn.addEventListener('click', () => {
      const wrap = btn.closest('.code-wrap');
      const code = wrap ? wrap.querySelector('pre code') : null;
      if (!code) return;
      const original = btn.textContent;
      const lang = localStorage.getItem('lang') || 'ca';
      let done = 'Copiat!';
      try {
        const pack = window.translations?.[lang] || window.translations?.ca;
        if (pack && pack.tema && pack.tema.copiat) done = pack.tema.copiat;
      } catch (e) {
        /* ignore */
      }
      navigator.clipboard.writeText(code.innerText).then(() => {
        btn.textContent = done;
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      });
    });
  });
</script>

<style is:global>
  html:not(.topic-unlocked) .topic-page-content {
    display: none !important;
  }
  html.topic-unlocked .topic-lock-screen {
    display: none !important;
  }
</style>
